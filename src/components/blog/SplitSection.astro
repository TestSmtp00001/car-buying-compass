---
// A left-right (image + text) block for blog content, e.g. an exterior shot
// next to a paragraph of commentary. Set `reverse` to put the image on the
// right instead. Omit `image` to show a placeholder box until a real photo
// is added.
interface Props {
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
}

const { image, imageAlt = "", reverse = false } = Astro.props;
---

<div class="mt-10 grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
  <div class:list={[reverse ? "lg:order-2" : "lg:order-1"]}>
    {
      image ? (
        <img src={image} alt={imageAlt} class="w-full border border-border" loading="lazy" />
      ) : (
        <div class="exhibit-photo">
          <span class="font-mono text-xs leading-relaxed tracking-wide text-muted-foreground">
            PHOTO — to be added
          </span>
        </div>
      )
    }
  </div>
  <div class:list={["[&>p+p]:mt-4", reverse ? "lg:order-1" : "lg:order-2"]}>
    <slot />
  </div>
</div>
