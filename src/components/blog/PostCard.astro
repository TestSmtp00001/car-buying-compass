---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, topic, publishDate } = post.data;
const formattedDate = new Intl.DateTimeFormat("en-AU", { dateStyle: "long" }).format(publishDate);
---

<article class="editorial-card">
  <p class="section-marker">{topic}</p>
  <h3 class="mt-2 text-xl font-bold text-foreground">
    <a href={`/blog/${post.id}`} class="no-underline hover:text-primary">{title}</a>
  </h3>
  <p class="mt-3 text-muted-foreground">{description}</p>
  <p class="mt-4 text-sm text-muted-foreground">
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
  </p>
</article>
